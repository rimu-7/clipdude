{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipDude",
  "version": "../package.json",
  "identifier": "com.walter.clipdude",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost"
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "ClipDude",
        "width": 920,
        "height": 640,
        "minWidth": 700,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "visible": false,
        "focus": true,
        "decorations": true,
        "shadow": true,
        "skipTaskbar": false,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "publisher": "Walter",
    "category": "Utility",
    "shortDescription": "A blazing-fast native clipboard manager.",
    "longDescription": "ClipDude is a fast, private, local-only clipboard manager for macOS, Windows, and Linux.",
    "copyright": "© 2026 Walter",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "signingIdentity": null,
      "providerShortName": null
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2QjdDQ0ZDREJENkZGOEEKUldTSy85YmIvTXkzSm0rdGp5cHNEWVBvMDJqYVp3U0V0QnAyNllab3NjRWZBODlzUUlqcEJ1ZVgK",
      "endpoints": [
        "https://github.com/rimu-7/clipdude/releases/latest/download/latest.json"
      ]
    }
  }
}
